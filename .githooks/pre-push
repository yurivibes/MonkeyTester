#!/usr/bin/env bash
# pre-push: run the same docs-drift gate CI runs on a PR (ci/docs-drift.sh), so
# a branch that changes source files without touching AGENTS.md is stopped
# before it's pushed and a PR is opened.
# Enable once per clone (covers every worktree): git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify
set -euo pipefail

remote="${1:-origin}"
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

# PRs target master (or main); compare against the remote's copy.
base_ref=""
for b in master main; do
  if git rev-parse -q --verify "refs/remotes/$remote/$b" >/dev/null; then
    base_ref="$remote/$b"; break
  fi
done
if [ -z "$base_ref" ]; then
  echo "pre-push: no $remote/master or $remote/main, skipping docs-drift check" >&2
  exit 0
fi

status=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch delete
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  base="$(git merge-base "$base_ref" "$local_sha" 2>/dev/null || true)"
  [ -z "$base" ] && continue
  [ "$base" = "$local_sha" ] && continue   # nothing new on top of master
  list="$(mktemp)"
  git diff --name-only "$base" "$local_sha" > "$list"
  echo "pre-push: docs-drift check for ${local_ref#refs/heads/} against $base_ref"
  if ! CHANGED_FILES="$list" bash "$root/ci/docs-drift.sh"; then
    status=1
  fi
  rm -f "$list"
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused. Update AGENTS.md (or push with --no-verify)." >&2
fi
exit "$status"
